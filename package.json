{
  "name": "stream-orator",
  "version": "0.0.25",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "include"
  ],
  "description": "Add streaming support to DOM elements",
  "main": "StreamOrator.js",
  "module": "StreamOrator.js",
  "exports": {
    ".": {
      "default": "./StreamOrator.js",
      "types": "./StreamOrator.ts"
    },
    "./StreamOrator.js": {
      "default": "./StreamOrator.js",
      "types": "./StreamOrator.ts"
    }
  },
  "files": [
    "*.js",
    "types.d.ts"
  ],
  "types": "types.d.ts",
  "scripts": {
    "test": "playwright test",
    "serve": "python3 ./node_modules/ssi-server/ssi_server.py",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "devDependencies": {
    "ssi-server": "0.0.1",
    "@playwright/test": "1.56.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/stream-orator.git"
  },
  "author": "anderson.bruce.b@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/stream-orator/issues"
  },
  "homepage": "https://github.com/bahrus/stream-orator#readme"
}
